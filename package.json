{
  "name": "focus-ledger",
  "version": "0.1.0",
  "description": "Local ADHD-friendly task tracker with MCP tools for coding agents.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron": "npm run build && electron electron/main.cjs",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:1420 && electron electron/main.cjs --dev\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "mcp": "tsx mcp/server.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows.ps1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@tauri-apps/api": "^2.6.0",
    "better-sqlite3": "^11.10.0",
    "electron": "^42.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.6.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.20.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
